{
  "name": "dysnomia-terminal-ng",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:public": "VITE_ENABLE_SIM_MODE=1 npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "runner:build": "vite build --config runner.vite.config.ts"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@langchain/langgraph": "^1.4.18",
    "dompurify": "^3.4.16",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "viem": "^2.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^4.1.11"
  }
}
