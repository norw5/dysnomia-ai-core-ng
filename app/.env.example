# app/.env — local secrets for dev + test runs. GITIGNORED — never commit.
# The SHIPPED app never reads this file: users enter the key at runtime in
# SETTINGS → Agent (BYOK field, visible indicator, spend caps).
#
# Naming rule (session-45 convention): secrets NEVER use the VITE_ prefix —
# Vite inlines every VITE_* var into the built bundle, which would ship the
# key inside dist/. Bare names stay server/dev-side by construction.

# scoped + credit-capped OpenRouter key (owner-provided)
OPENROUTER_API_KEY=
